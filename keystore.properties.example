# release 签名配置模板：复制为 keystore.properties 并填入真实值（绝不提交）
# 用 keytool 生成：keytool -genkeypair -v -keystore phoneguard-release.keystore -alias <alias> -keyalg RSA -keysize 2048 -validity 10000
storeFile=phoneguard-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
